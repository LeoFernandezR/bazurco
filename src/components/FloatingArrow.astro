---
import { cn } from "../lib/utils";

const pathname = Astro.url.pathname;

const isContactPage = pathname === "/contacto";
---

<a
  class={cn(
    "fixed block right-0 bottom-20 z-50 cursor-pointer hover:scale-105 transition-transform duration-300 motion-safe:animate-small-bounce",
    isContactPage && "hidden"
  )}
  href="/contacto"
>
  <div class="bg-blue-400 p-4 rounded-l-full">
    <span class="text-3xl font-bold text-white pl-2">Cotiza ahora!</span>
  </div>
</a>
