---
interface PageParallaxProps {
  imageUrl: string;
  title: string;
}

const { imageUrl, title } = Astro.props as PageParallaxProps;
---

<div class="h-[60vh] md:h-[80vh] shadow-lg relative">
  <div
    class="absolute top-0 left-0 w-full h-full -z-10 bg-cover bg-center bg-fixed bg-no-repeat"
    style={`background-image:url('${imageUrl}');`}
  >
  </div>
  <div class="flex h-full items-center justify-center">
    <h1 class="text-[7vw] font-bold text-white bg-indigo-500 p-4">{title}</h1>
  </div>
</div>
