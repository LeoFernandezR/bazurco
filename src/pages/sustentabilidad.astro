---
import PageParallax from "../components/PageParallax.astro";
import heroImage from "../assets/sustentabilidad.BUENA.avif";
import sectionImage from "../assets/seccion-sustentabilidad.png";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

const SustentabilidadData = [
  {
    title: "SEGURIDAD Y SALUD EN EL TRABAJO",
    description:
      "En Bazurco, la seguridad y salud de nuestros empleados son fundamentales. Trabajamos con procesos y procedimientos enfocados en la prevención, brindando un entorno seguro y saludable. Capacitamos y concientizamos sobre la importancia del trabajo seguro, asegurando que cada miembro del equipo pueda desarrollarse con el respaldo y la experiencia de la compañía.",
  },
  {
    title: "MEDIO AMBIENTE",
    description:
      "El cuidado del Medio Ambiente es una prioridad en Bazurco. Analizando el impacto que nuestras actividades pueden tener sobre el Planeta, mitigando los riesgos con una orientación a la reducción del uso de recursos no renovables. Esto distingue a la compañía como una empresa ecológicamente responsable.",
  },
  {
    title: "SEGURIDAD VIAL",
    description:
      "Bazurco cuenta con procedimientos certificados en los vehículos que son operados por la empresa, garantizando así la seguridad en todo momento, además de una rápida y eficaz respuesta para la prestación del servicio. La compañía cuenta con un alto estándar de calidad en seguridad vial mediante el control del proceso y la capacitación permanente del personal.",
  },
];
---

<Layout
  title="Sustentabilidad"
  description="Compromiso con la sustentabilidad y el medio ambiente"
>
  <PageParallax imageUrl={heroImage.src} title="Sustentabilidad" />
  <div class="relative">
    <Image
      src={sectionImage}
      alt="Responsabilidad Ambiental"
      class="w-full h-full object-cover absolute inset-0 opacity-10"
    />
    <div class="py-24 max-w-xl mx-auto text-black text-center">
      <h3 class="text-4xl mb-4 font-semibold">Responsabilidad Ambiental</h3>
      <p class="text-lg">
        Bazurco promueve prácticas que reducen el impacto ambiental, como el
        ahorro de recursos, la utilización de productos ecológicos y la
        clasificación y reciclaje de residuos. Fomentamos el uso de transporte
        eficiente y el ahorro energético en todas nuestras operaciones. Nuestro
        objetivo es reducir la huella de carbono y avanzar hacia una gestión más
        sostenible.
      </p>
    </div>
  </div>
  <div class="max-w-[80%] mx-auto py-24">
    <div class="flex gap-12 justify-center">
      {
        SustentabilidadData.map((item) => (
          <div class="flex-1">
            <h4 class="text-2xl mb-2 font-semibold text-blue-400">
              {item.title}
            </h4>
            <p class="text-justify">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
