---
import Layout from "../layouts/Layout.astro";
import heroImage from "../assets/sERVICIOS.BUENA.webp";
import PageParallax from "../components/PageParallax.astro";
import { cn } from "../lib/utils";
import { Image } from "astro:assets";
//ServicesCardImages
import Service1 from "../assets/services_cards/service-1.jpeg";
import Service2 from "../assets/services_cards/service-2.jpeg";
import Service3 from "../assets/services_cards/service-3.jpeg";
import Service4 from "../assets/services_cards/service-4.jpeg";
import Service5 from "../assets/services_cards/service-5.jpeg";
import Service6 from "../assets/services_cards/service-6.jpeg";

// import Service1 from "../assets/servicios-gimnasio.jpeg";
// import Service2 from "../assets/servicio-centro-de-salud.jpg";
// import Service3 from "../assets/servicio-shopping.jpg";
// import Service4 from "../assets/servicio-espacios-verdes.webp";
// import Service5 from "../assets/servicio-fabrica.png";
// import Service6 from "../assets/servicio-edificio.webp";

//ServicesHeaderIcons
import LimpiezaIcon from "../assets/icons/limpieza.png";
import MantenimientoIcon from "../assets/icons/mantenimiento.png";
import ParquizacionIcon from "../assets/icons/parquizacion.png";
//ServicesAuxiliaresIcons
import ServiciosAuxiliaresDerecha from "../assets/icons/servicios_auxiliares_derecha.png";
import ServiciosAuxiliaresIzquierda from "../assets/icons/servicios_auxiliares_izquierda.png";

const servicesHeaderContent: {
  title: string;
  description: string;
  icon: ImageMetadata;
}[] = [
  {
    title: "Limpieza",
    description:
      "Nuestro servicio de limpieza está diseñado para garantizar espacios seguros, ordenados y en óptimas condiciones de uso. Realizamos tareas de limpieza general, mantenimiento diario, tratamientos específicos según el tipo de superficie y rutinas de higiene adaptadas a cada entorno, ya sean oficinas, plantas industriales, depósitos o áreas de alta circulación. Trabajamos con equipos capacitados, productos adecuados y procedimientos estandarizados que aseguran resultados consistentes y de alta calidad. Nuestro objetivo es que cada instalación se mantenga limpia, funcional y preparada para el desarrollo normal de las actividades, respondiendo con rapidez y flexibilidad ante cualquier necesidad puntual.",
    icon: LimpiezaIcon,
  },
  {
    title: "Mantenimiento",
    description:
      "Nuestro servicio de limpieza está diseñado para garantizar espacios seguros, ordenados y en óptimas condiciones de uso. Realizamos tareas de limpieza general, mantenimiento diario, tratamientos específicos según el tipo de superficie y rutinas de higiene adaptadas a cada entorno, ya sean oficinas, plantas industriales, depósitos o áreas de alta circulación. Trabajamos con equipos capacitados, productos adecuados y procedimientos estandarizados que aseguran resultados consistentes y de alta calidad. Nuestro objetivo es que cada instalación se mantenga limpia, funcional y preparada para el desarrollo normal de las actividades, respondiendo con rapidez y flexibilidad ante cualquier necesidad puntual.",
    icon: MantenimientoIcon,
  },
  {
    title: "Parquización",
    description:
      "Nuestro servicio de parquización está orientado a mantener y mejorar los espacios verdes, asegurando áreas prolijas, seguras y visualmente agradables. Realizamos corte de césped, poda, desmalezado, mantenimiento de canteros, limpieza de sectores exteriores y cuidado general del arbolado según las necesidades de cada establecimiento. Contamos con equipos capacitados y herramientas específicas que nos permiten trabajar de manera eficiente tanto en parques amplios como en áreas verdes de uso cotidiano. Nuestro objetivo es conservar cada espacio en óptimas condiciones, aportando orden, estética y funcionalidad al entorno.",
    icon: ParquizacionIcon,
  },
];

const servicesCardContentCopy = [
  {
    title: "Instalaciones y complejos deportivos",
    description:
      "Con una planificación personalizada para cada caso, nuestros servicios de limpieza e higienización juegan un papel clave, garantizando un entorno óptimo y cuidado que eleva la experiencia tanto de los organizadores como de los participantes.",
    imageUrl: Service1.src,
  },

  {
    title: "Centro de salud",
    description:
      "Existen lugares donde se pone a prueba la capacidad de servicio: los grandes centros de atención sanitaria. Allí es donde se requiere la combinación de personal altamente especializado, innovación tecnológica y productos químicos que garanticen la gestión medioambiental y las adecuadas barreras sanitarias. Se utilizan sistemas de limpieza diferenciados para las zonas de alto, mediano y bajo riesgo.",
    imageUrl: Service2.src,
  },
  {
    title: "Hogares empresas y centros comerciales",
    description:
      "En Bazurco brindamos servicios de limpieza y mantenimiento diseñados para adaptarse a las necesidades específicas de cada cliente. Nuestro compromiso se refleja en la eficiencia y calidad de cada intervención, respaldadas por un equipo profesional y dedicado. Trabajamos con responsabilidad y atención al detalle para garantizar entornos limpios, cuidados y pensados para el bienestar de las personas que los utilizan a diario. ",
    imageUrl: Service3.src,
  },
  {
    title: "Parquizado y mantenimiento de espacios verdes",
    description:
      "Nos especializamos en el cuidado de espacios verdes, manteniéndolos saludables y estéticos durante todo el año. Adaptamos nuestras técnicas según las necesidades de cada estación y aplicamos prácticas sustentables que protegen el entorno. Colaboramos con cada cliente para crear espacios armónicos, funcionales y en sintonía con la naturaleza.",
    imageUrl: Service4.src,
  },
  {
    title: "Fábricas y plantas industriales",
    description:
      "La empresa cuenta con amplia experiencia en servicios de mantenimiento en fábricas y plantas industriales, siempre estableciendo procesos específicos y desarrollando tareas de procedimientos solicitados por cada cliente. manera segura y sustentable.",
    imageUrl: Service5.src,
  },
  {
    title: "Bancos y edificios gubernamentales",
    description:
      "Considerando la importancia que tiene este rubro, se ofrece personal calificado de alta experiencia y baja rotación, haciendo de las instalaciones un lugar acorde a las exigencias del competitivo mercado financiero y gubernamental.",
    imageUrl: Service6.src,
  },
];

const servicesCardContent = [
  {
    title: "Limpieza en Altura",
    description:
      "Nuestros servicios de limpieza en altura están diseñados para atender fachadas, vidrios externos, estructuras verticales y superficies de difícil acceso, utilizando técnicas seguras y equipamiento especializado. Contamos con personal entrenado en trabajos con cuerdas, andamios y plataformas elevadoras, cumpliendo estrictamente con las normas de seguridad vigentes. Esto nos permite operar en edificios corporativos, plantas industriales y centros logísticos sin interrumpir el funcionamiento diario, garantizando resultados duraderos y una estética impecable en cada intervención.",
    imageUrl: Service1.src,
  },

  {
    title: "Desinfección y control de plagas",
    description:
      "Brindamos servicios de desinfección y control de plagas orientados a mantener ambientes seguros, higiénicos y libres de agentes nocivos. Utilizamos productos habilitados y métodos certificados, adecuados para industrias, oficinas, depósitos y espacios de alto tránsito.",
    imageUrl: Service2.src,
  },
  {
    title: "Mantenimiento de ascensores",
    description:
      "Ofrecemos mantenimiento preventivo y correctivo de ascensores para garantizar su funcionamiento seguro, estable y eficiente. Nuestro equipo técnico realiza controles periódicos, ajustes y reparaciones que prolongan la vida útil del equipamiento y minimizan interrupciones en el servicio.",
    imageUrl: Service3.src,
  },
  {
    title: "Retiro de residuos",
    description:
      "Nos encargamos del retiro y la gestión adecuada de residuos, adaptándonos a las necesidades de cada operación. Organizamos la recolección interna, clasificación, traslado y disposición final con criterios de seguridad y sustentabilidad.",
    imageUrl: Service4.src,
  },
  {
    title: "Servicios de vending",
    description:
      "Instalamos y gestionamos máquinas de vending con productos seleccionados según las preferencias del cliente. Nos ocupamos del abastecimiento, mantenimiento y control del equipo para asegurar un servicio continuo, práctico y confiable para empleados y visitantes.",
    imageUrl: Service5.src,
  },
  {
    title: "Bancos y edificios gubernamentales",
    description:
      "Realizamos mantenimiento preventivo y correctivo de sistemas de aire acondicionado, garantizando un funcionamiento eficiente y una adecuada calidad del aire. Incluye limpieza de filtros, revisión de componentes y reparaciones necesarias para asegurar confort y rendimiento energético.",
    imageUrl: Service6.src,
  },
];
---

<Layout title="Servicios" description="Información sobre nuestros servicios">
  <PageParallax imageUrl={heroImage.src} title="Servicios" />

  <div class="max-w-[80%] mx-auto py-12">
    <div class="flex flex-col">
      {
        servicesHeaderContent.map((item, idx) => (
          <div class="mb-12">
            <h3
              class={cn(
                "text-2xl md:text-3xl uppercase font-bold mb-2 text-indigo-500",
                idx % 2 === 0 ? "text-left" : "text-right"
              )}
            >
              <span
                class={cn(
                  "flex items-center gap-1",
                  idx % 2 === 0 ? "flex-row" : "flex-row-reverse"
                )}
              >
                <Image
                  class="size-20 md:size-32"
                  src={item.icon}
                  alt={`barzurco ${item.title}`}
                />
                <span>{item.title}</span>
              </span>
            </h3>
            <p class="md:pl-[4%] md:text-xl text-justify">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="max-w-[82%] mx-auto py-12">
    <h2
      class="md:text-7xl text-4xl break-words font-bold md:text-white text-indigo-500 mb-8 text-center uppercase"
    >
      <span class="flex items-center justify-center flex-col md:flex-row gap-4">
        <Image
          src={ServiciosAuxiliaresIzquierda}
          alt="Servicios Auxiliares Izquierda Bazurco"
        />
        <span class="md:bg-blue-400 md:rounded-full md:py-4">
          Servicios Auxiliares Administrativos
        </span>
        <Image
          src={ServiciosAuxiliaresDerecha}
          alt="Servicios Auxiliares Derecha Bazurco"
        />
      </span>
    </h2>
    <p class="text-xl py-10 text-justify md:text-start">
      Nuestro servicio de auxiliares administrativos brinda apoyo operativo para
      optimizar las tareas diarias de cada organización y aliviar la carga de
      los equipos internos. Realizamos gestiones básicas, control de
      documentación, asistencia en recepción, ordenamiento de archivos,
      coordinación de trámites y soporte en actividades administrativas
      cotidianas, siempre con personal capacitado y criterios de trabajo
      eficientes. Nos adaptamos a las necesidades de cada área para mejorar los
      tiempos, el orden y la continuidad de los procesos.
      <span class="block text-center mt-4 italic">
        Estos son algunos de los servicios que podemos ofrecerles…
      </span>
    </p>
  </div>

  <div
    class="max-w-[90%] mx-auto gap-16 py-12 flex flex-wrap justify-center items-center"
  >
    {
      servicesCardContent.map((item) => (
        <div class="w-[390px] h-[80vh] md:h-[70vh] overflow-hidden relative group rounded-lg">
          <img
            src={item.imageUrl}
            alt={item.title}
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-indigo-500 scale-0 group-hover:scale-100 transition-transform duration-500 origin-top-left rounded-lg" />
          <div class="absolute inset-0 bg-black/50 flex  justify-center transition-opacity duration-300 p-6 ">
            <div class="text-white ">
              <h4 class="text-3xl uppercase break-normal text-center">
                {item.title}
              </h4>
              <p class="mt-2 md:text-lg">{item.description}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Layout>
