const nosotrosHeaderContent: Array<{
  title: string;
  description: string;
}> = [
  {
    title: "¿Quiénes somos?",
    description:
      "En Bazurco Facility Services ofrecemos soluciones integrales para asegurar el correcto funcionamiento, la limpieza y el orden de las instalaciones de nuestros clientes. Nuestro trabajo incluye la limpieza general de espacios y un servicio de mantenimiento preventivo y correctivo que garantiza la operatividad de la infraestructura mediante inspecciones, reparaciones y asistencia técnica. También brindamos servicios auxiliares y apoyo en situaciones que requieren una respuesta inmediata, como reacondicionamiento de áreas, gestión de residuos o refuerzo de equipos internos. Con planificación, supervisión constante y presencia operativa, aseguramos entornos seguros, eficientes y adaptados a las necesidades de cada organización.",
  },
  {
    title: "¿Qué hacemos?",
    description:
      "En Bazurco Facility Services brindamos soluciones integrales orientadas a asegurar el correcto funcionamiento, la limpieza y el orden de las instalaciones de nuestros clientes. Nuestro trabajo abarca la limpieza general de espacios, el mantenimiento preventivo y correctivo de infraestructura, la desinfección y el ordenamiento de áreas operativas, así como servicios auxiliares que complementan y optimizan la actividad diaria de cada organización. También intervenimos en situaciones que requieren una respuesta inmediata, ofreciendo apoyo para reacondicionar ambientes, gestionar residuos, recuperar zonas afectadas y reforzar equipos internos cuando es necesario. Nuestro enfoque combina planificación, supervisión constante y presencia operativa para garantizar entornos seguros, eficientes y en perfectas condiciones de uso, adaptándonos siempre a las necesidades específicas de cada cliente.",
  },
  {
    title: "¿Cómo lo hacemos?",
    description:
      "En Bazurco Facility Services trabajamos con un enfoque planificado y operativo que combina organización, supervisión constante y equipos capacitados en cada área de servicio. Realizamos diagnósticos iniciales para entender las necesidades de cada cliente y definir un plan de trabajo a medida. Implementamos procedimientos estandarizados, controles de calidad y comunicación permanente para asegurar que cada tarea se ejecute de manera eficiente y segura. Operamos con recursos propios, tecnología adecuada y una coordinación interna que nos permite responder con rapidez, adaptarnos a imprevistos y garantizar resultados consistentes en todos los entornos donde intervenimos.",
  },
  {
    title: "¿Por qué nosotros?",
    description:
      "Elegir Bazurco Facility Services significa contar con un socio confiable que prioriza la calidad, la eficiencia y la atención personalizada. Nos destacamos por nuestra capacidad de respuesta, nuestro compromiso operativo y la experiencia de equipos entrenados para trabajar en entornos exigentes. Aportamos soluciones claras y prácticas, con supervisión constante y un enfoque orientado a resultados reales, no solo a tareas. Adaptamos cada servicio a las necesidades específicas de cada cliente, garantizando continuidad operativa, seguridad y un estándar de trabajo consistente. Nuestra forma de trabajar se basa en la transparencia, el cumplimiento y la construcción de relaciones duraderas, lo que convierte a Bazurco en un aliado estratégico para el día a día y también para situaciones extraordinarias.",
  },
];

const nosotrosFootColumns: Array<{
  title: string;
  description: string;
  list?: string[];
}> = [
  {
    title: "Calidad",
    description:
      "En Bazurco, alcanzar la excelencia es el motor que impulsa cada una de nuestras acciones. Para lograrlo, invertimos en la capacitación continua de nuestro equipo humano, fomentando tanto el desarrollo profesional como el crecimiento personal. Incorporamos maquinaria de última generación y tecnologías innovadoras que optimizan nuestros procesos, al mismo tiempo que mantenemos un fuerte compromiso con la sostenibilidad y el cuidado del medio ambiente, asegurando así un servicio de calidad con impacto positivo.",
  },

  {
    title: "Misión",
    description:
      "La misión de Bazurco es brindar un servicio de excelencia, especializado y sustentable, que responda a las necesidades de nuestros clientes con soluciones eficientes y confiables.",
  },
  {
    title: "Visión",
    description:
      "Como empresa líder en servicios especializados y sustentables, nuestra visión es consolidar nuestra posición en el mercado y expandirnos a nuevas regiones, llevando nuestra eficiencia, innovación y compromiso a más comunidades. Queremos seguir generando impacto positivo y generando crecimiento y valor en nuestros clientes.",
  },
  {
    title: "Valores",
    description: "Con nuestros clientes y la sociedad",
    list: [
      "Conducta ética: integridad, honestidad, compromiso y responsabilidad.",
      "Comunicación efectiva: atendiendo a las necesidades del cliente y brindando respuestas.",
      "Trabajo en equipo: para lograr la eficiencia en el servicio.",
      "Sustentabilidad: teniendo como prioridad el cuidado del medio ambiente.",
    ],
  },
];
---

<Layout title="Bazurco - Nosotros" description="Conoce más sobre nosotros">
  <PageParallax imageUrl={heroImage.src} title="Bienvenido a Bazurco" />

  <div class="mx-auto max-w-[80%] py-16">
    <div class="flex flex-col gap-16">
      {
        //Client removed this grid...
        // nosotrosGrid.map((service) => (
        //   <NosotrosCard
        //     client:load
        //     title={service.title}
        //     description={service.description}
        //     imageUrl={service.imageUrl}
        //   />
        // ))

        nosotrosHeaderContent.map((item) => (
          <div>
            <h2 class="text-4xl font-semibold text-blue-400 mb-6">
              {item.title}
            </h2>
            <p class="text-justify mx-[6%]">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>

  <ClientsCarousel client:load />

  <div class="flex md:px-20 px-8 py-16 gap-16 flex-col md:flex-row">
    {
      nosotrosFootColumns.map((item) => (
        <div class="flex-1 flex flex-col gap-2">
          <h3 class="text-4xl font-semibold text-blue-400">{item.title}</h3>
          {item?.list ? (
            <ul class="list-disc mt-2 space-y-2">
              {item.list.map((listItem) => (
                <li class="ml-3">{listItem}</li>
              ))}
            </ul>
          ) : (
            <p class="text-justify">{item.description}</p>
          )}
        </div>
      ))
    }
  </div>
</Layout>
