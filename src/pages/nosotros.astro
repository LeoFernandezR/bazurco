import Layout from "../layouts/Layout.astro";

import heroImage from "../assets/Nosotros.buena.jpeg";
import Service1 from "../assets/servicios-gimnasio.jpeg";
import Service2 from "../assets/servicio-centro-de-salud.jpg";

import ClientsCarousel from "../components/ClientsCarousel";
import NosotrosCard from "../components/ServiceCard";

