---
import PageParallax from "../components/PageParallax.astro";
import Layout from "../layouts/Layout.astro";

import heroImage from "../assets/Nosotros.buena.jpeg";
import Service1 from "../assets/servicios-gimnasio.jpeg";
import Service2 from "../assets/servicio-centro-de-salud.jpg";

import ClientsCarousel from "../components/ClientsCarousel";
import NosotrosCard from "../components/ServiceCard";

const nosotrosGrid = [
  {
    title: "Mantenimiento",
    description:
      "El mantenimiento es fundamental para asegurar la continuidad y la optimización de las instalaciones de inmuebles y equipos en todas las actividades. El servicio de mantenimiento prestado por Bazurco se realiza a partir de analizar y diagnosticar el estado de equipos e instalaciones, para proponer las mejoras a realizar y el tipo de mantenimiento que resulte necesario.En Bazurco nos especializamos en brindar servicios integrales de mantenimiento para una amplia variedad de espacios, incluyendo hogares, oficinas, industrias, centros comerciales, fábricas y espacios verdes y recreativos. Nuestro enfoque combina la eficiencia operativa con el uso de tecnología y recursos adecuados para garantizar el correcto funcionamiento de instalaciones, equipos e infraestructuras. Nos ocupamos de tareas como mantenimiento eléctrico, sanitario, mecánico, climatización, pintura, jardinería y más, con personal capacitado y comprometido con altos estándares de calidad y seguridad. Trabajamos bajo una planificación personalizada para cada cliente, asegurando la continuidad operativa de los espacios y contribuyendo al cuidado del patrimonio edilicio a largo plazo.",
    imageUrl: Service1.src,
  },
  {
    title: "Limpieza",
    description:
      "La limpieza representa diferentes cosas para distintas personas y organizaciones, ya que cada espacio presenta necesidades específicas y expectativas particulares. Lo que todos tienen en común es la importancia de contar con un entorno limpio, ordenado y seguro, que contribuya al bienestar, promueva la productividad y genere una impresión positiva en quienes lo habitan o lo visitan. En Bazurco entendemos que un ambiente higiénico no solo impacta la salud, sino también el confort y la eficiencia de quienes lo habitan o visitan. Por eso, nuestro enfoque se basa en cumplir con los más altos estándares de seguridad e higiene, adaptándonos a las necesidades de cada cliente y cumpliendo con las normativas y certificaciones internacionales como ISO y protocolos sanitarios. Contamos con personal altamente capacitado y procesos estructurados que aseguran resultados consistentes y confiables, alineados con las mejores prácticas del sector. Nuestro compromiso es ofrecer un servicio profesional que brinde confianza, calidad y seguridad en cada detalle.",
    imageUrl: Service2.src,
  },
];

const nosotrosData: Array<{
  title: string;
  description: string;
  list?: string[];
}> = [
  {
    title: "Calidad",
    description:
      "En Bazurco, alcanzar la excelencia es el motor que impulsa cada una de nuestras acciones. Para lograrlo, invertimos en la capacitación continua de nuestro equipo humano, fomentando tanto el desarrollo profesional como el crecimiento personal. Incorporamos maquinaria de última generación y tecnologías innovadoras que optimizan nuestros procesos, al mismo tiempo que mantenemos un fuerte compromiso con la sostenibilidad y el cuidado del medio ambiente, asegurando así un servicio de calidad con impacto positivo.",
  },

  {
    title: "Misión",
    description:
      "La misión de Bazurco es brindar un servicio de excelencia, especializado y sustentable, que responda a las necesidades de nuestros clientes con soluciones eficientes y confiables.",
  },
  {
    title: "Visión",
    description:
      "Como empresa líder en servicios especializados y sustentables, nuestra visión es consolidar nuestra posición en el mercado y expandirnos a nuevas regiones, llevando nuestra eficiencia, innovación y compromiso a más comunidades. Queremos seguir generando impacto positivo y generando crecimiento y valor en nuestros clientes.",
  },
  {
    title: "Valores",
    description: "Con nuestros clientes y la sociedad",
    list: [
      "Conducta ética: integridad, honestidad, compromiso y responsabilidad",
      "Comunicación efectiva: atendiendo a las necesidades del cliente y brindando respuestas.",
      "Trabajo en equipo: para lograr la eficiencia en el servicio.",
      "Sustentabilidad: teniendo como prioridad el cuidado del medio ambiente.",
    ],
  },
];
---

<Layout title="Bazurco - Nosotros" description="Conoce más sobre nosotros">
  <PageParallax imageUrl={heroImage.src} title="Bienvenido a Bazurco" />

  <div class="mx-auto max-w-[80%] py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        nosotrosGrid.map((service) => (
          <NosotrosCard
            client:load
            title={service.title}
            description={service.description}
            imageUrl={service.imageUrl}
          />
        ))
      }
    </div>
  </div>

  <ClientsCarousel client:load />

  <div class="flex md:px-20 px-8 py-16 gap-16 flex-col md:flex-row">
    {
      nosotrosData.map((item) => (
        <div class="flex-1 flex flex-col gap-2">
          <h3 class="text-4xl font-semibold text-blue-400">{item.title}</h3>
          {item?.list ? (
            <ul class="list-disc mt-2 space-y-2">
              {item.list.map((listItem) => (
                <li class="ml-3">{listItem}</li>
              ))}
            </ul>
          ) : (
            <p class="text-justify">{item.description}</p>
          )}
        </div>
      ))
    }
  </div>
</Layout>
